# Copia este archivo como .env.local y completa los valores (NUNCA subas .env.local a git).
# Supabase → Settings → API
VUE_APP_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# anon public key: es pública a propósito, la seguridad la dan las políticas RLS.
# La service_role key NUNCA va aquí ni en el frontend.
VUE_APP_SUPABASE_ANON_KEY=pegar-aqui
