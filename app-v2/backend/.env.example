# Backend — Leo Perfecto
# NUNCA commitear el archivo .env real (está en .gitignore). Veto V-1 / Hallazgo H-1.

PORT=3000
# Origen permitido para CORS (la SPA en desarrollo; en producción, la URL de Netlify)
CORS_ORIGIN=http://localhost:5173

# Supabase (Dashboard → Project Settings → API)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# service_role key: SOLO backend. La anon key va en el frontend si se usa auth en cliente.
SUPABASE_SERVICE_ROLE_KEY=pegar-aqui

# Gemini (Google AI Studio → API key NUEVA; revocar la clave antigua expuesta)
GEMINI_API_KEY=pegar-aqui
GEMINI_MODEL=gemini-2.0-flash

# Caché de pistas de Leo IA (por nivel + fragmento); 24 h por defecto
IA_CACHE_TTL_MS=86400000
